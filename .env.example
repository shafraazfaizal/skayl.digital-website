# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Resend API key used by src/app/api/contact/route.ts to email enquiries.
RESEND_API_KEY=

# Where contact-form enquiries are delivered (defaults to hello@skayl.digital).
CONTACT_TO_EMAIL=hello@skayl.digital
